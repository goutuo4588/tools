# ========== 服务配置 ==========
# 端口（部署平台通常会自动注入 PORT，本地默认 3000）
PORT=3000

# 管理员后台登录密码（务必改成你自己的强密码！）
ADMIN_PASS=请改成你的强密码

# ========== 163 邮箱发信配置 ==========
# MAIL_USER : 你的 163 邮箱完整地址，例如 123456@163.com
# MAIL_PASS : 163 邮箱的 SMTP 授权码（不是登录密码！在邮箱设置 → POP3/SMTP/IMAP 里开启并生成）
# MAIL_FROM : 发件人，通常就等于 MAIL_USER
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
